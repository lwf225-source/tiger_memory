# Copy to a PRIVATE file outside the repository. Do not commit credentials.
# This template deliberately cannot start a paid service without configuration.
export TIGER_MEMORY_DIR=/var/lib/tiger-memory-open-source-v4
# Dedicated canonical absolute path OUTSIDE every Git checkout, not $PWD/aml_data_store.
# Local user alternative: $HOME/.local/share/tiger-memory-aml-v4 (check topology first).
# Read-only, no credentials/API/listener:
# python -m tiger_memory.aml_store_preflight --store "$TIGER_MEMORY_DIR"
# Complete allowlisted DMX URL; model remains text-embedding-v4, 1024 dimensions.
export TIGER_MEMORY_EMBEDDING_ENDPOINT=https://www.dmxapi.cn/v1/embeddings
export TIGER_MEMORY_EMBEDDING_API_KEY=
# Explicit Aliyun rollback only: choose the workspace/region's complete official
# HTTPS /compatible-mode/v1/embeddings URL and its matching credential. Legacy
# DASHSCOPE_API_KEY is used only when the generic key variable is absent, never
# for DMX. Unset TIGER_MEMORY_EMBEDDING_API_KEY to opt into that legacy route.
# export DASHSCOPE_API_KEY=
# Different key: authenticates AML's requests to our Add/Search service.
export AML_API_KEY=
# Change to 1 only when remote transmission and API charges are authorized.
export TIGER_MEMORY_ALLOW_REMOTE=0
# Check without paid requests: python -m tiger_memory.aml_open_source --check-config
# Launch separately: python -m tiger_memory.aml_open_source --host 127.0.0.1 --port 18191
# Mandatory operator-provisioned receipt outside both repository and ledger.
# The receipt binds an already initialized ledger, approved caps and supplier evidence.
# Startup never creates credit or repairs/deletes a missing ledger.
export TIGER_MEMORY_EMBEDDING_BUDGET_RECEIPT=
# Full local startup precheck (opens receipt read-only; no remote call):
# python -m tiger_memory.aml_open_source --check-startup
